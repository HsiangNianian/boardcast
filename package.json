{
  "name": "boardcast",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "description": "Talk, and the whiteboard draws itself. Local-first live meeting diagrams.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/glyphs.mjs && vite",
    "build": "node scripts/glyphs.mjs && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/engine/*.test.ts\"",
    "eval": "node eval/run.ts",
    "tauri": "node scripts/fetch-llama.mjs && node scripts/fetch-voice.mjs && tauri",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@excalidraw/excalidraw": "0.18.1",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "2.12.4",
    "elkjs": "0.12.0",
    "perfect-freehand": "1.2.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.4",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "hanzi-writer-data": "2.0.1",
    "hersheytext": "2.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "packageManager": "pnpm@11.12.0"
}
