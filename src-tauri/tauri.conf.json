{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "boardcast",
  "version": "0.14.0",
  "identifier": "games.mmstudio.boardcast",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-llama.mjs && node scripts/fetch-voice.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "boardcast",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://esm.sh https://unpkg.com; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://esm.sh https://unpkg.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "llama/": "llama/", "voice/": "voice/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg3RUMzMzZGNzQ2NDA2OEEKUldTS0JtUjBielBzaHlNNkVTYmZXMkx5SHdXNndBWDhCSFJiSmJwcG5KdVhIbXcwNmFBaktzNVEK",
      "endpoints": ["https://github.com/HsiangNianian/boardcast/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
