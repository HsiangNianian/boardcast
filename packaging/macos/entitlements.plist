<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- What the hardened runtime, which notarization requires, must still allow. Alcyo is not sandboxed. -->
<plist version="1.0">
<dict>
  <!-- Listening to the meeting through the microphone (the app, and the Apple speech helper). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
