{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "boardcast",
  "version": "0.2.0",
  "identifier": "games.mmstudio.boardcast",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/fetch-llama.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "boardcast",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https://esm.sh https://unpkg.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* http://localhost:* https://esm.sh https://unpkg.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": { "llama/": "llama/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
